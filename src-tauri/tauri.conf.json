{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WaLiAPI",
  "version": "0.2.1",
  "identifier": "waliapi.xiaofuge.cn",
  "mainBinaryName": "waliapi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WaLiAPI - Local LLM Gateway",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 680,
        "decorations": true,
        "dragDropEnabled": false,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxNjAzQkFFODNGNEFBNzQKUldSMHF2U0RyanRnd2ZuV0pKNWRPUlNFeUdkWC85VFI4emRxd3haeEJZdWlURlZqUkR3eW5SK3IK",
      "endpoints": [
        "https://gitcode.net/KnowledgePlanet/waliapi/-/raw/v0.1.1/latest.json",
        "https://github.com/KnowledgePlanet/waliapi/releases/latest/download/latest.json"
      ]
    }
  }
}
